# DClaw Learn Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://learn:learn@localhost:5432/dclaw_learn

# AI Providers
OPENROUTER_API_KEY=          # Required for cloud models
OPENROUTER_URL=https://openrouter.ai/api/v1

# Auth (Logto) — leave empty if not using SSO
LOGTO_ENDPOINT=
LOGTO_AUDIENCE=

# App
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3008
